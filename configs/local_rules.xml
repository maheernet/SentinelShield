<group name="syslog,sshd,sentinelshield,">
  <!-- Base rule for failed SSH login -->
  <rule id="100200" level="5">
    <if_sid>5710</if_sid>
    <description>SentinelShield: SSH authentication failure detected.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Correlated threshold rule for Brute Force -->
  <rule id="100201" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>SentinelShield Alert: SSH Brute-Force threshold reached (5 failures in 60s) from $(srcip).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>
</group>
